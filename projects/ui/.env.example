# The UI runs fully mocked by default: MSW answers every request, so `pnpm dev`
# needs no backend at all (spec §6).
#
# Set to "false" to talk to a real API on :8000. The Vite dev server proxies
# /api there in both modes and strips the prefix, because the backend mounts its
# routes at the root.
VITE_USE_MOCKS=true
