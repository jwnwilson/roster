# Mock-first is the default and needs no file at all: with VITE_USE_MOCKS unset,
# MSW answers every request and `pnpm dev` runs with no backend (spec §6).
#
# Copy this to .env only to turn that off and talk to a real API on :8000. The
# Vite dev server proxies /api there in both modes without rewriting, because the
# backend mounts its routes under /api too.
#
# Production builds do not need this file: projects/ui/.env.production pins
# VITE_USE_MOCKS=false for every build, so a shipped bundle can never carry mocks.
VITE_USE_MOCKS=false
