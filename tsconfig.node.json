{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "paths": { "@main/*": ["./electron/main/*"], "@shared/*": ["./shared/*"] }
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts", "tests/main/**/*.ts", "electron.vite.config.ts"]
}
